---
import Layout from '../components/Layout.astro';
import PrototypeCard from '../components/PrototypeCard.astro';
import ProductDocCard from '../components/ProductDocCard.astro';
import { labelForType, loadProductDocs } from '../lib/productKb';
import fs from 'node:fs';
import path from 'node:path';

// Discover prototypes from <project-root>/runs/sprint/<run-id>/prototypes/**/*.html
// (this Astro app lives at packages/zachflow-gallery/, so project root is ../..)
const projectRoot = path.resolve('../..');
const runsDir = path.join(projectRoot, 'runs', 'sprint');
const productDocs = loadProductDocs(projectRoot);
const productGroups = Array.from(
  productDocs.reduce((groups, doc) => {
    const key = doc.type;
    const group = groups.get(key) ?? [];
    group.push(doc);
    groups.set(key, group);
    return groups;
  }, new Map<string, typeof productDocs>()),
).sort(([a], [b]) => labelForType(a).localeCompare(labelForType(b)));

let prototypes: { run: string; prototype: string }[] = [];

if (fs.existsSync(runsDir)) {
  const runs = fs.readdirSync(runsDir, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name);

  for (const run of runs) {
    const protoDir = path.join(runsDir, run, 'prototypes');
    if (!fs.existsSync(protoDir)) continue;

    const walk = (dir: string, prefix = '') => {
      for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
        const full = path.join(dir, entry.name);
        const rel = prefix ? `${prefix}/${entry.name}` : entry.name;
        if (entry.isDirectory()) {
          walk(full, rel);
        } else if (entry.name.endsWith('.html')) {
          const proto = rel.replace(/\.html$/, '');
          prototypes.push({ run, prototype: proto });
        }
      }
    };
    walk(protoDir);
  }
}

prototypes.sort((a, b) => {
  if (a.run !== b.run) return a.run.localeCompare(b.run);
  return a.prototype.localeCompare(b.prototype);
});
---

<Layout title="zachflow gallery">
  <h1>Prototypes</h1>
  {prototypes.length === 0 ? (
    <p>
      No prototypes found in <code>runs/sprint/&lt;run-id&gt;/prototypes/*.html</code>.
      Once your sprint produces prototype HTML files, they'll appear here automatically on the next build.
    </p>
  ) : (
    <>
      <p class="count">{prototypes.length} prototype{prototypes.length === 1 ? '' : 's'} across {new Set(prototypes.map((p) => p.run)).size} run{new Set(prototypes.map((p) => p.run)).size === 1 ? '' : 's'}.</p>
      <div class="grid">
        {prototypes.map(({ run, prototype }) => (
          <PrototypeCard run={run} prototype={prototype} />
        ))}
      </div>
    </>
  )}

  <section class="section" id="product-kb">
    <div class="section-heading">
      <div>
        <h2>Product KB</h2>
        <p>OKF-compatible product docs from <code>.zachflow/kb/products/</code>.</p>
      </div>
      <span>{productDocs.length} doc{productDocs.length === 1 ? '' : 's'}</span>
    </div>

    {productDocs.length === 0 ? (
      <p>
        No product KB docs found. Run <code>bash scripts/kb-bootstrap.sh --demo</code> or add
        validated product docs under <code>.zachflow/kb/products/&lt;product&gt;/</code>.
      </p>
    ) : (
      <div class="product-groups">
        {productGroups.map(([type, docs]) => (
          <section class="product-group">
            <h3>{labelForType(type)}</h3>
            <div class="product-grid">
              {docs.map((doc) => <ProductDocCard doc={doc} />)}
            </div>
          </section>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .count {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--card-border);
  }
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .section-heading p {
    color: var(--muted);
    margin: 0.25rem 0 0;
  }
  .section-heading span {
    color: var(--muted);
    white-space: nowrap;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .product-groups,
  .product-group {
    display: grid;
    gap: 1rem;
  }
  .product-group h3 {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  @media (max-width: 640px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
